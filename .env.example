# ==============================================================================
# MINIMAL E-COMMERCE WITH MANUAL MEESHO FULFILLMENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Database, Storage & Auth)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# CRITICAL: Service role key is only used on the server. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# RAZORPAY CONFIGURATION (Payment Gateway)
# Get these from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# ADMIN DASHBOARD CREDENTIALS
# Used for direct admin session protection & authentication
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@meeshoapp.com
ADMIN_PASSWORD=AdminSecurePassword2026!
ADMIN_JWT_SECRET=super-secret-jwt-signing-key-meeshoapp-32chars
